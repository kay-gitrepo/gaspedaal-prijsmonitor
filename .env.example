# Verplicht: kies drie verschillende, lange, willekeurige waarden. Deel ze nooit.
UI_PASSWORD=vervang-door-een-sterk-wachtwoord
SESSION_SECRET=vervang-door-64-willekeurige-tekens
HA_REFRESH_TOKEN=vervang-door-een-aparte-lange-willekeurige-token

# Optioneel. Een betaalde Gemini Developer API key van Google AI Studio.
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_GEMINI_CALLS_PER_RUN=20

# Gebruik true indien de app via HTTPS achter een reverse proxy draait.
# Bij lokale HTTP-toegang moet deze false blijven (anders werkt de sessiecookie niet).
SECURE_COOKIES=false
DATABASE_PATH=/data/prices.sqlite3
INTEGRATION_LOG_RETENTION_DAYS=90
DISAPPEARANCE_DAYS=7
DATA_SOURCE_APPROVED=false

# Rechtstreekse Gaspedaal JSON-API: EXPERIMENTEEL. Alleen activeren nadat het
# daadwerkelijke endpoint via DevTools is vastgesteld en jij gebruik toestaat.
# {search_url} wordt URL-gecodeerd, {page} wordt een positief paginanummer.
# Het onderstaande is expres LEEG: er is geen geverifieerd zoek-endpoint bekend.
GASPEDAAL_API_SEARCH_TEMPLATE=
GASPEDAAL_API_ITEMS_PATH=data.results
GASPEDAAL_API_FIELDS_JSON={}
GASPEDAAL_API_MAX_PAGES=10
